# このファイルをコピーして .env を作り、キーを入れる:
#   cp .env.example .env
# .env は .gitignore 済み。絶対に GitHub に上げないこと。

# === 当日の教材用（agent.py）=========================================
OPENAI_API_KEY=sk-ここに研究室の共有キーを貼る

# 使うモデル。ループを何十回も回すので、まずは安いモデルで試す。
# 当日使えるモデル名は共有キーで実際に叩いて確認すること（未検証）。
MODEL=gpt-5-mini


# === 開発・検証用（agent_claude.py）===================================
# 講師（自分）が手元で動作確認するためだけのもの。
# 参加者には配らない。当日も使わない。
CLAUDE_API_KEY=sk-ant-ここに自分のキーを貼る

# 省略時は claude-opus-5 を使う。
# 検証を安く回したいなら claude-haiku-4-5 に下げてもよい。
CLAUDE_MODEL=claude-opus-5
